check {
  fetch_resource.sh { ${IWNET_URL} C{extern_iwnet} IWNET_SRC_DIR }
}
run {
  shell { ^{BUILD_TYPE= ${BUILD_TYPE}} autark --prefix C{} ${IWNET_SRC_DIR} }
  consumes {
    ${IWNET_SRC_DIR}
  }
  produces {
    C{include/iwnet/iwnet.h}
  }
}
run-on-install {
  shell {
    autark -J1 --prefix ${INSTALL_PREFIX} 
    set { _ 
      if { ${EJDB_BUILD_SHARED_LIBS}
        -DIWNET_BUILD_SHARED_LIBS=1
      }
    }
    ${IWNET_SRC_DIR} 
  }
}
