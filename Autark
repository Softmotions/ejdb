check {
  changelog_gnu.sh { S{Changelog} }
  system.sh
  test_blocks.sh { IW_BLOCKS }
  test_pthread.sh
  test_qsort_r.sh
}

meta {
  name { ejdb2 }

  version { ${CHANGELOG_VERSION} }
  version_major { ${CHANGELOG_VERSION_MAJOR} }
  version_minor { ${CHANGELOG_VERSION_MINOR} }

  description {  Embeddable JSON database engine (EJDB2) }
  website { https://github.com/Softmotions/ejdb }
  vendor { Softmotions (https://softmotions.com) }
  maintainer { Anton Adamansky <adamansky@gmail.com> }
  license { MIT }
}

option { IWNET_URL                IWNET external project sources URL }
option { EJDB_BUILD_SHARED_LIBS   Build shared libraries }
option { EJDB_BUILD_TESTS         Build test cases }
option { EJDB_RUN_TESTS           Build and run test cases }
option { EJDB_ENABLE_HTTP         Build the HTTP/WebSocket server (src/jbr, requires iwnet). Default: 1 }
option { ENABLE_ASAN              Turn on address sanitizer }
option { ENABLE_UBSAN             Turn on UB sanitizer }
option { ENABLE_DEBINFO           Generate debuginfo even in release mode }

set {
  META_REVISION
  @{ git rev-parse --short HEAD }
}

include { peg.autark }

if { !defined { EJDB_ENABLE_HTTP }
  set {
    EJDB_ENABLE_HTTP 1
  }
}

# Guards the HTTP/WebSocket server in the ejdb2 core (see src/ejdb2cfg.h.in and
# src/Autark).  Disabled for the Android build, where iwnet is not available.
if { ${EJDB_ENABLE_HTTP}
  set {
    JB_HTTP 1
  }
}

if { ${EJDB_RUN_TESTS}
  set {
    EJDB_BUILD_TESTS 1
  }
}

if { eq { ${BUILD_TYPE} Release }
  set {
    STRIP_CMD strip --strip-debug
  }
}

set {
  SANITIZER_FLAGS
  if { ${ENABLE_ASAN}
    -fsanitize=address
    -fno-omit-frame-pointer
  }
  if { ${ENABLE_UBSAN}
    -fsanitize=undefined
    -fno-omit-frame-pointer
  }
}

if { !defined { IWNET_URL } 
  set {
    IWNET_URL
    https://github.com/Softmotions/iwnet/archive/refs/tags/v1.4.0.zip
  }
}

env {
  PKG_CONFIG_PATH
  C{${INSTALL_PKGCONFIG_DIR}}
}


if { !defined { PTHREAD_LFLAG} 
  error { No pthreads found! }
}

if { ${EJDB_ENABLE_HTTP}
  include { iwnet.autark }
} else {
  include { iowow.autark }
}

set {
  LDFLAGS_PKGCONF
}

set {
  LDFLAGS
  ..${LDFLAGS}
  if { ${EJDB_ENABLE_HTTP}
    ..@@{${PKGCONF} --libs --static libiwnet}
  } else {
    ..@@{${PKGCONF} --libs --static libiowow}
  }
  ..${LDFLAGS_PKGCONF}
  ..${SANITIZER_FLAGS}
}

set {
  CFLAGS
  -std=gnu11
  -fsigned-char
  -fPIC

  -Wall
  -Wextra
  -Wfatal-errors
  -Wno-implicit-fallthrough
  -Wno-missing-braces
  -Wno-missing-field-initializers
  -Wno-sign-compare
  -Wno-unknown-pragmas
  -Wno-unused-function
  -Wno-unused-parameter
  -Wno-overlength-strings

  if { ${EJDB_ENABLE_HTTP}
    ..@@{${PKGCONF} --cflags libiwnet}
  } else {
    ..@@{${PKGCONF} --cflags libiowow}
  }

  ..${SANITIZER_FLAGS}

  if { prefix { ${BUILD_TYPE} Debug }
    -O0
    -ggdb
    -fno-omit-frame-pointer
    -Werror
    -Wno-unused-variable
    -DDEBUG -D_DEBUG -UNDEBUG
  } else {
    if { ${ENABLE_DEBINFO}
      -O2
      -ggdb
      -fno-omit-frame-pointer
    } else {
      -O3
    }
    -DNDEBUG
    -DIW_RELEASE
  }
  if { defined { SYSTEM_BIGENDIAN }
    -DIW_BIGENDIAN
    -DWORDS_BIGENDIAN
  }
  if { defined { SYSTEM_BITNESS_64 }
    -DIW_64
  }
  if { defined { SYSTEM_BITNESS_32 }
    -DIW_32
  }
  if { defined { SYSTEM_LINUX }
    -D_XOPEN_SOURCE=700
  }
  if { defined { SYSTEM_DARWIN }
    -D_DARWIN_C_SOURCE
  }
  if { defined { SYSTEM_WINDOWS } 
    -D__USE_MINGW_ANSI_STDIO
    -Wno-pedantic-ms-format"
  }
  if { defined { IW_BLOCKS } 
    -fblocks
    -DIW_BLOCKS
  }
  if { !defined { EJDB_BUILD_SHARED_LIBS }
    -DIW_NODLL
  } else {
    -DIW_API_EXPORTS
  }
  if { ${EJDB_BUILD_TESTS}
    -DIW_TESTS
  }

  -D_DEFAULT_SOURCE
  -D_LARGEFILE_SOURCE
  -D_FILE_OFFSET_BITS=64

  -I C{src}
  -I S{src}
}

include { man/Autark }
include { src/Autark }