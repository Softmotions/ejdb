# Autark toolchain descriptor: Android NDK target `arm64-v8a` (AArch64).
#
# This file is not a standalone build script, it is used by
# `scripts/build-abi.sh` which invokes the regular ejdb2 build as a cross build
# into a per-ABI cache:
#
#   autark --toolchain toolchains/android-arm64-v8a.autark -H <cache> <ejdb root>
#
# The NDK layout depends on the build host, so the build script passes it in the
# environment:
#
#   ANDROID_NDK_BIN        <ndk>/toolchains/llvm/prebuilt/<host tag>/bin
#   ANDROID_NDK_SYSROOT    <ndk>/toolchains/llvm/prebuilt/<host tag>/sysroot
#   ANDROID_NDK_API_LEVEL  Android API level, must be >= 24
toolchain {
  id       { android-arm64-v8a }
  system   { android }
  arch     { aarch64 }
  arch-alt { arm64 }
  bits     { 64 }
  endian   { little }

  sysroot  { ${ANDROID_NDK_SYSROOT} }

  cc       { ^{${ANDROID_NDK_BIN} /aarch64-linux-android ${ANDROID_NDK_API_LEVEL} -clang} }
  ar       { ^{${ANDROID_NDK_BIN} /llvm-ar} }
  ranlib   { ^{${ANDROID_NDK_BIN} /llvm-ranlib} }
  strip    { ^{${ANDROID_NDK_BIN} /llvm-strip} }

  # Build tools (the PEG `leg` generator) must run on the build host.
  host-cc  { cc }
  host-cxx { c++ }
}
