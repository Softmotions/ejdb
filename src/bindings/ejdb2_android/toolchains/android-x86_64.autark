# Autark toolchain descriptor: Android NDK target `x86_64` (AMD64).
#
# See toolchains/android-arm64-v8a.autark for the descriptor contract and the
# environment variables provided by scripts/build-abi.sh.
toolchain {
  id       { android-x86_64 }
  system   { android }
  arch     { x86_64 }
  arch-alt { x64 }
  bits     { 64 }
  endian   { little }

  sysroot  { ${ANDROID_NDK_SYSROOT} }

  cc       { ^{${ANDROID_NDK_BIN} /x86_64-linux-android ${ANDROID_NDK_API_LEVEL} -clang} }
  ar       { ^{${ANDROID_NDK_BIN} /llvm-ar} }
  ranlib   { ^{${ANDROID_NDK_BIN} /llvm-ranlib} }
  strip    { ^{${ANDROID_NDK_BIN} /llvm-strip} }

  host-cc  { cc }
  host-cxx { c++ }
}
