configure {
  ejdb2.h.in
  ejdb2cfg.h.in
}

configure {
  libejdb2.pc.in
}

option { EJDB_PUBLIC_HEADERS_DESTINATION  Installation path relative to INSTALL_PREFIX for ejdb2 public header files. }
if { !defined { EJDB_PUBLIC_HEADERS_DESTINATION }
  set {
    EJDB_PUBLIC_HEADERS_DESTINATION ^{ ${INSTALL_INCLUDE_DIR} / ${META_NAME} }
  }
}

set {
  SOURCES
  ejdb2.c
}

set {
  PUB_HDRS
  ejdb2.h
}

include { jql/Autark }
include { jbi/Autark }

if { ${EJDB_ENABLE_HTTP}
  include { jbr/Autark }
  include { jbs/Autark }
}

cc {
  ${SOURCES}
  ${CFLAGS}
  ${CC}
  consumes {
    ejdb2.h
    ejdb2cfg.h
    if { ${EJDB_ENABLE_HTTP}
      C{include/iwnet/iwnet.h}
    }
  }
}

set {
  LIBEJDB_A
  CC { libejdb2.a }
}

set {
  LDFLAGS_TEST
  ${LIBEJDB_A}
  ..${LDFLAGS}
}

run {
  exec { ${AR} rcs ${LIBEJDB_A} ${CC_OBJS} }
  consumes {
    ${CC_OBJS}
  }
  produces {
    ${LIBEJDB_A}
  }
}

install { ${INSTALL_LIB_DIR} ${LIBEJDB_A} }

if { ${EJDB_BUILD_SHARED_LIBS}
  if {!defined {SYSTEM_DARWIN}
    set {
      LIBEJDB_SO_BASE
      libejdb2.so
    }
    set {
      LIBEJDB_SO_BIN
      ^{${LIBEJDB_SO_BASE} . ${META_VERSION}}
    }
    set {
      LIBEJDB_SO_NAME
      ^{${LIBEJDB_SO_BASE} . ${META_VERSION_MAJOR}}
    }
    run {
      exec { ${CC} -shared -o ${LIBEJDB_SO_BIN}  ${CC_OBJS} ${LDFLAGS} }
      if { ${STRIP_CMD} 
        exec { ${STRIP_CMD} ${LIBEJDB_SO_BIN} }
      }
      consumes {
        ${CC_OBJS}
      }
      produces {
        ${LIBEJDB_SO_BIN}
      }
    }
  } else {
    set {
      LIBEJDB_SO_BASE
      libejdb2.dylib
    }
    set {
      LIBEJDB_SO_BIN
      ^{libejdb2. ${META_VERSION} .dylib}
    }
    set {
      LIBEJDB_SO_NAME
      ^{libejdb2. ${META_VERSION_MAJOR} .dylib}
    }
    run {
      exec { ${CC} -dynamiclib  
        -install_name ^{@rpath/ ${LIBEJDB_SO_BASE}} 
        -compatibility_version ${META_VERSION_MAJOR}
        -current_version ${META_VERSION}
        -o ${LIBEJDB_SO_BIN} 
        ${CC_OBJS} ${LDFLAGS}
      }
      if { ${STRIP_CMD} 
        exec { ${STRIP_CMD} ${LIBEJDB_SO_BIN} }
      }
      consumes {
        ${CC_OBJS}
      }
      produces {
        ${LIBEJDB_SO_BIN}
      }
    }
  }
  run {
    exec { ln -sf ${LIBEJDB_SO_BIN} ${LIBEJDB_SO_NAME} }
    exec { ln -sf ${LIBEJDB_SO_BIN} ${LIBEJDB_SO_BASE} }
    consumes {
      ${LIBEJDB_SO_BIN}
    }
  }
  install { ${INSTALL_LIB_DIR} ${LIBEJDB_SO_BIN} ${LIBEJDB_SO_BASE} ${LIBEJDB_SO_NAME} }
}

install { ${INSTALL_PKGCONFIG_DIR} libejdb2.pc }
install { ${EJDB_PUBLIC_HEADERS_DESTINATION} ${PUB_HDRS} }

if { ${EJDB_BUILD_TESTS} 
  include { tests/Autark }
}

option { BUILD_BINDING_JNI      Build ejdb Java binding }
option { BUILD_BINDING_NODEJS   Build ejdb Nodejs binding }
option { BUILD_BINDING_ANDROID  Build the Android (NDK) native libraries of the Java binding }
option { ANDROID_ABIS           Android ABIs to build. Default: arm64-v8a x86_64 }
option { ANDROID_API_LEVEL      Android API level of the Android binding. Default: 24 }
option { ANDROID_BUILD_TYPE     Build type of the Android native code. Default: Release }
option { ANDROID_RUN_TESTS      Run the Android instrumentation tests (requires a device/emulator) }

if { ${BUILD_BINDING_ANDROID}
  if { !defined { ANDROID_ABIS}
    set { ANDROID_ABIS arm64-v8a x86_64 }
  }
  if { !defined { ANDROID_API_LEVEL}
    set { ANDROID_API_LEVEL 24 }
  }
  if { !defined { ANDROID_BUILD_TYPE}
    set { ANDROID_BUILD_TYPE Release }
  }
}

if { or { ${BUILD_BINDING_JNI} ${BUILD_BINDING_NODEJS} ${BUILD_BINDING_ANDROID} }
  include { bindings/Autark }
}