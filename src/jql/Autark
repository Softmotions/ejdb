run {
  exec { ${LEG_EXEC} -o CC{jqp.c} SS{jqp.leg} }
  consumes {
    jqp.leg
  }
  produces {
    CC{jqp.c}
  }
}

set {
  parent {
    SOURCES
  }
  ..${SOURCES}
  jql/jql.c
  CC{jqp.c}
}

set {
  parent {
    PUB_HDRS
  }
  ..${PUB_HDRS}
  jql/jql.h
}

set {
  root {
    CFLAGS
  }
  ..${CFLAGS}
  -I SS{}
}

if { ${EJDB_BUILD_TESTS} 
  include { tests/Autark }
}