cc {
  set { _
    ejdb_test1.c
    ejdb_test2.c
    ejdb_test3.c
    ejdb_test4.c
    ejdb_test5.c
    ejdb_test6.c
  }
  set { _ ..${CFLAGS} -DIW_STATIC -DIW_TESTS -DIW_TEST_HARNESS="ejdb2" }
}

foreach {
  OBJ
  ${CC_OBJS}
  run {
    exec { ${CC} ${OBJ} ${LDFLAGS_TEST} -o %{${OBJ}} }
    consumes { ${LIBEJDB_A} ${OBJ} }
    produces { %{${OBJ}} }
  }
}

if { ${EJDB_RUN_TESTS} 
  foreach {
    OBJ
    ${CC_OBJS}
    run {
      always
      shell { %{${OBJ}} }
      consumes { %{${OBJ}} }
    }
  }
}